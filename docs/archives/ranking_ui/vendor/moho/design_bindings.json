  "bindings": [
    {
      "when": "tab-change",
      "layer": "L6_tab_switch",
      "region": "tab_active",
      "place": "cover",
      "aspect": "none",
      "no_ring": true,
      "note": "underline wipe sized to active tab"
    },
    {
      "when": "save-ok",
      "layer": "L12_save_ok",
