{
  "id": "exp7-view-states/1",
  "version": "1.8.4-art",
  "params": "art/design/params.json",
  "elementStates": {
    "idle": { "lift": 0, "tilt": 0, "scale": 1, "opacity": 1, "ring": "none", "bg": "surface", "border": "border" },
    "hover": { "lift": 1.5, "tilt": 0, "scale": 1, "opacity": 1, "ring": "none", "bg": "subtle", "border": "border" },
    "focus": { "lift": 1.5, "tilt": 0, "scale": 1, "opacity": 1, "ring": "focus", "bg": "surface", "border": "selection" },
    "pressed": { "lift": 0, "tilt": 0, "scale": 0.97, "opacity": 1, "ring": "focus", "bg": "subtle", "border": "selection", "note": "scale+selection border/ring — matches JRViews RING.pressed; not wash-only" },
    "selected": { "lift": 2, "tilt": 0, "scale": 1, "opacity": 1, "ring": "gold", "bg": "selectionWash", "border": "selection" },
    "dragging": { "lift": 4, "tilt": 0, "scale": 1.02, "opacity": 0.96, "ring": "none", "bg": "surface", "border": "selection" },
    "drop-pending": { "lift": 3, "tilt": 0, "scale": 1.01, "opacity": 0.9, "ring": "gold", "bg": "subtle", "border": "accent", "note": "accent/gold ring — must NOT share invalid/caution red" },
    "invalid": { "lift": 0, "tilt": 0, "scale": 1, "opacity": 1, "ring": "caution", "bg": "surface", "border": "invalid" },
    "settling": { "lift": 1, "tilt": 0, "scale": 1, "opacity": 1, "ring": "none", "bg": "surface", "border": "border" },
    "disabled": { "lift": 0, "tilt": 0, "scale": 1, "opacity": 0.38, "ring": "none", "bg": "softDisc", "border": "disabled", "note": "opacity+softDisc+disabled border — measure ROI opacity/contrast, not global mean; must read disabled" }
  },
  "appStates": {
    "loading": { "ambient": "paused", "pointer": "off", "loader": true },
    "ready": { "ambient": "drifting", "pointer": "tracking", "loader": false },
    "preview": { "ambient": "paused", "pointer": "tracking", "loader": false },
    "applying": { "ambient": "paused", "pointer": "off", "loader": false },
    "undo": { "ambient": "paused", "pointer": "tracking", "loader": false }
  },
  "parallaxStates": {
    "ambient-drifting": { "loop": true, "fronts": false },
    "ambient-paused": { "loop": false, "fronts": "pointer-only" },
    "ambient-off": { "loop": false, "fronts": false },
    "pointer-still": { "tracking": false },
    "pointer-tracking": { "tracking": true }
  },
  "avatarStates": {
    "absent": { "mode": "initials", "exclusive": true },
    "loading": { "mode": "pending", "exclusive": true, "showNeitherUntilSettle": true },
    "ready": { "mode": "photo", "clip": "circle", "exclusive": true },
    "error": { "mode": "initials", "exclusive": true },
    "update": { "mode": "pending-then-photo", "exclusive": true },
    "freed": { "mode": "initials", "exclusive": true }
  },
  "transitions": [
    { "from": "*", "to": "hover", "event": "pointerenter", "ms": 90, "easing": "click", "clickPath": true },
    { "from": "hover", "to": "idle", "event": "pointerleave", "ms": 100, "easing": "click", "clickPath": true },
    { "from": "*", "to": "focus", "event": "focusin", "ms": 90, "easing": "click", "clickPath": true },
    { "from": "focus", "to": "idle", "event": "focusout", "ms": 100, "easing": "click", "clickPath": true },
    { "from": "*", "to": "pressed", "event": "pointerdown", "ms": 60, "easing": "click", "clickPath": true },
    { "from": "pressed", "to": "hover", "event": "pointerup", "ms": 80, "easing": "click", "clickPath": true },
    { "from": "pressed", "to": "selected", "event": "click", "ms": 100, "easing": "click", "clickPath": true },
    { "from": "*", "to": "dragging", "event": "dragstart", "ms": 80, "easing": "click", "clickPath": true },
    { "from": "dragging", "to": "drop-pending", "event": "drag", "ms": 0, "easing": "linear", "clickPath": true },
    { "from": "drop-pending", "to": "settling", "event": "drop", "ms": 120, "easing": "settle", "clickPath": true },
    { "from": "dragging", "to": "idle", "event": "cancel", "ms": 120, "easing": "settle", "clickPath": true, "interrupt": "Escape" },
    { "from": "*", "to": "invalid", "event": "invalid", "ms": 120, "easing": "invalid", "clickPath": true },
    { "from": "invalid", "to": "idle", "event": "cancel", "ms": 120, "easing": "settle", "clickPath": true },
    { "from": "settling", "to": "idle", "event": "settle-done", "ms": 100, "easing": "settle", "clickPath": true },
    { "from": "*", "to": "disabled", "event": "disable", "ms": 0, "easing": "linear", "clickPath": true },
    { "from": "disabled", "to": "idle", "event": "enable", "ms": 0, "easing": "linear", "clickPath": true }
  ],
  "interrupts": ["Escape", "cancel", "pointercancel", "lostpointercapture", "visibilityHidden", "reducedMotion"],
  "rules": {
    "clickVisualsNeverGateAction": true,
    "clickPathMaxMs": 120,
    "reducedDisablesLoopsTransitionsTransformsParallax": true,
    "hiddenPausesAmbient": true,
    "idleRafZero": true,
    "noCompetingAnimations": true,
    "bestNeqSelected": true,
    "viewsEmitHostsPropose": true
  },
  "surfaces": {
    "Calendar": ["idle", "hover", "focus", "pressed", "selected", "dragging", "invalid", "disabled", "empty", "loading", "error"],
    "Board": ["idle", "hover", "focus", "pressed", "selected", "dragging", "drop-pending", "invalid", "disabled", "empty", "loading", "error"],
    "Plan": ["idle", "hover", "focus", "pressed", "selected", "disabled", "loading", "error"],
    "PlatformBar": ["idle", "hover", "focus", "pressed", "photo", "initials", "loading"],
    "AppsPicker": ["idle", "hover", "focus", "pressed", "selected", "disabled"],
    "BudgetTabs": ["idle", "hover", "focus", "pressed", "selected", "disabled"],
    "BudgetType": ["idle", "hover", "focus", "pressed", "selected", "disabled"]
  }
}
