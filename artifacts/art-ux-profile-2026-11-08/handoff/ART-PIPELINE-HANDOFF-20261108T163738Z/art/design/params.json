{
  "id": "exp7-art-params/1",
  "version": "1.8.4-art",
  "source": "Retains Exp7 light theme + Exp7Slabs PX2 camera; single light/scene for art pass",
  "geometry": {
    "barH": 44,
    "avatar": 36,
    "gap": 8,
    "inset": 8,
    "radii": { "control": 8, "chip": 5, "avatar": 999, "panel": 10, "section": 6, "day": 6 },
    "bevelPx": 1.0,
    "thicknessPx": 1.0,
    "lift": { "idle": 0, "hover": 1.5, "focus": 1.5, "pressed": 0, "selected": 2, "dragging": 4, "invalid": 0, "disabled": 0 },
    "material": { "panel": "glass-light", "control": "opaque-light", "avatar": "photo-or-soft-disc" }
  },
  "light": {
    "type": "area-disk",
    "size": 420,
    "azimuthDeg": 0,
    "elevationDeg": 72,
    "distance": 900,
    "bounces": 2,
    "caustics": false,
    "note": "One light. Trace from Blender when CLI available; until then analytical ground-plane fits only."
  },
  "camera": {
    "model": "pinhole",
    "focalMmChosen": 85,
    "focalSweepMm": [18, 24, 35, 50, 70, 85, 105, 135, 200],
    "sensorWidthMm": 36,
    "matchedFraming": true,
    "distancePx": 2099.1,
    "cameraShiftPx": 60,
    "exaggeration": 15.64,
    "pivotHeight": 3.7,
    "near": 10,
    "far": 4000,
    "distortionGatePct": 3.0,
    "vpTolerancePx": 0.75,
    "depthTolerancePx": 0.5
  },
  "parallax": {
    "formula": "shift * z / (D - z)",
    "D": 2099.1,
    "front": { "outer": 0.9676, "inner": -0.7697 },
    "ring": { "outer": 0.6421, "inner": 0.9035 }
  },
  "timing": {
    "clickPathMaxMs": 120,
    "applyMaxMs": 100,
    "selectNextFrameMaxMs": 120,
    "frameP95MaxMs": 16.8,
    "easingClick": [0.2, 0.8, 0.2, 1],
    "easingSettle": [0.22, 1, 0.36, 1],
    "easingInvalid": [0.36, 0.1, 0.2, 1.2]
  },
  "gates": {
    "contrastMin": 4.5,
    "clipIssuesMax": 0,
    "idleRafMax": 0,
    "styleRecalcPerSecMax": 1,
    "luminanceDropPct": 3.0,
    "halfPixel": 0.5
  },
  "palette": {
    "surface": "#ffffff",
    "subtle": "#f4f6fa",
    "text": "#1c2333",
    "muted": "#49556a",
    "accent": "#75510f",
    "border": "#8a96aa",
    "selection": "#2458a6",
    "anchor": "#6841a6",
    "invalid": "#a00",
    "disabled": "#9aa3b2",
    "softDisc": "#eef1f6",
    "critical": "#fff0e7",
    "moderate": "#fff6dc",
    "low": "#e8f5ef"
  },
  "images": {
    "abi": "JRDI/1",
    "maxEdge": 256,
    "maxEntries": 32,
    "clip": "circle",
    "hosts": ["avatars.githubusercontent.com", "github.com", "raw.githubusercontent.com"],
    "cors": "anonymous",
    "credentials": "omit"
  }
}
